<plugin
    xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="community-cordova-plugin-nfc"
    version="1.8.0">

    <name>NFC</name>
    <description>Community Cordova NFC Plugin - Read and write NDEF messages, advanced tag analysis, raw memory access</description>
    <license>MIT</license>
    <keywords>cordova,nfc,ndef,ntag,mifare,rfid</keywords>
    <repo>https://github.com/EYALIN/community-cordova-plugin-nfc</repo>
    <issue>https://github.com/EYALIN/community-cordova-plugin-nfc/issues</issue>

    <platform name="android">
        <js-module src="www/phonegap-nfc.js" name="NFC">
            <clobbers target="NfcPlugin" />
        </js-module>

        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="NfcPlugin">
                <param name="android-package" value="com.chariotsolutions.nfc.plugin.NfcPlugin"/>
                <param name="onload" value="true" />
            </feature>
        </config-file>

        <source-file src="src/android/src/com/chariotsolutions/nfc/plugin/NfcPlugin.java"
            target-dir="src/com/chariotsolutions/nfc/plugin"/>
        <source-file src="src/android/src/com/chariotsolutions/nfc/plugin/Util.java"
            target-dir="src/com/chariotsolutions/nfc/plugin"/>

        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.NFC"/>
            <uses-feature android:name="android.hardware.nfc" android:required="$NFC_REQUIRED"/>
        </config-file>

        <!-- Background tag reading (1.8.0): NFC_INTENT_FILTERS = none | any of ndef,tech,tag.
             scripts/android-nfc-intent-filters.js writes the launcher-activity intent filters. -->
        <preference name="NFC_INTENT_FILTERS" default="none" />
        <preference name="NFC_NDEF_MIME_TYPES" default="*/*" />
        <!-- APP-121: apps that are useless without NFC hardware (e.g. an NFC reader/writer) can set
             this to "true" so Google Play stops offering the app to phones without an NFC radio.
             Default stays "false" so existing consumers (an app that only USES NFC when present,
             e.g. an NFC checker/detector) are unaffected. -->
        <preference name="NFC_REQUIRED" default="false" />
        <hook type="after_prepare" src="scripts/android-nfc-intent-filters.js" />
        <hook type="before_plugin_uninstall" src="scripts/android-nfc-intent-filters.js" />

    </platform>

    <platform name="ios">
        <js-module src="www/phonegap-nfc.js" name="NFC">
            <clobbers target="NfcPlugin" />
        </js-module>

        <config-file parent="/*" target="config.xml">
            <feature name="NfcPlugin">
                <param name="ios-package" value="NfcPlugin" />
            </feature>
        </config-file>

        <!-- https://developer.apple.com/documentation/bundleresources/entitlements/com_apple_developer_nfc_readersession_formats?language=objc -->
        <!-- Note: NDEF is deprecated/disallowed in iOS SDK 26.1+ (iOS 18+). Use TAG only. -->
        <config-file parent="com.apple.developer.nfc.readersession.formats" platform="ios" target="*-Debug.plist">
            <array>
                <string>TAG</string>
            </array>
        </config-file>
        <config-file parent="com.apple.developer.nfc.readersession.formats" platform="ios" target="*-Release.plist">
            <array>
                <string>TAG</string>
            </array>
        </config-file>
        
        <header-file src="src/ios/NfcPlugin.h" />
        <source-file src="src/ios/NfcPlugin.m" />

        <!-- frameworks -->
        <framework src="CoreNFC.framework" weak="true" />

        <preference name="NFC_USAGE_DESCRIPTION" default="Read NFC Tags" />
        <!-- "*-Info.plist" resolves to App/App-Info.plist on cordova-ios 8 and to <Name>/<Name>-Info.plist
             on cordova-ios 7 and older (1.5.4-1.7.1 targeted App/App-Info.plist only, so apps on
             cordova-ios <= 7 shipped without the usage string and crashed on the first scan). -->
        <config-file target="*-Info.plist" parent="NFCReaderUsageDescription">
            <string>$NFC_USAGE_DESCRIPTION</string>
        </config-file>
    </platform>


</plugin>
